---
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProfile } from '../lib/collections';
import { paragraphs } from '../lib/content';

const profile = await getProfile();
---

<BaseLayout title="About" description={`About ${profile.name}.`}>
	<div class="container">
		<header class="page-header">
			<h1 class="page-title">About</h1>
		</header>
		<div class="bio">
			{paragraphs(profile.bio).map((text) => <p>{text}</p>)}
		</div>
		<div class="actions about-actions">
			<Button href={`mailto:${profile.email}`}>Email me</Button>
			{
				profile.links.linkedin && (
					<Button href={profile.links.linkedin} variant="outline">
						LinkedIn
					</Button>
				)
			}
		</div>
	</div>
</BaseLayout>

<style>
	.bio {
		display: flex;
		flex-direction: column;
		gap: 1.25em;
		max-width: var(--measure);
		color: var(--color-prose);
		font-size: 18px;
		line-height: 1.7;
	}
	.about-actions {
		margin-top: var(--space-6);
	}
</style>
