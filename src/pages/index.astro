---
import Hero from '../components/Hero.astro';
import PostListItem from '../components/PostListItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedProjects, getPosts, getProfile, getProjects } from '../lib/collections';
import { url } from '../lib/url';

const [profile, projects, featured, posts] = await Promise.all([
	getProfile(),
	getProjects(),
	getFeaturedProjects(3),
	getPosts(),
]);
const latest = posts.slice(0, 3);
---

<BaseLayout>
	<Hero profile={profile} hasProjects={projects.length > 0} />
	{
		featured.length > 0 && (
			<section class="container section" aria-labelledby="featured-heading">
				<div class="section-head">
					<h2 id="featured-heading" class="section-heading">Featured projects</h2>
					<a class="section-link" href={url('/projects/')}>All projects →</a>
				</div>
				<div class="grid-cards">
					{featured.map((project) => <ProjectCard project={project} />)}
				</div>
			</section>
		)
	}
	{
		latest.length > 0 && (
			<section class="container section" aria-labelledby="latest-heading">
				<div class="section-head">
					<h2 id="latest-heading" class="section-heading">Latest writing</h2>
					<a class="section-link" href={url('/blog/')}>All posts →</a>
				</div>
				{latest.map((post) => <PostListItem post={post} />)}
			</section>
		)
	}
</BaseLayout>
