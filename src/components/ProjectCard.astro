---
import { Image } from 'astro:assets';
import type { Project } from '../lib/collections';
import { url } from '../lib/url';
import Label from './Label.astro';

interface Props {
	project: Project;
	headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const { title, summary, stack, cover } = project.data;
const href = url(`/projects/${project.id}/`);
---

<article class="card">
	<a href={href} class="media" tabindex="-1" aria-hidden="true">
		{
			cover ? (
				<Image src={cover} alt="" widths={[480, 960]} sizes="(max-width: 720px) 100vw, 640px" />
			) : (
				<div class="placeholder">
					<span>{title}</span>
				</div>
			)
		}
	</a>
	<Heading class="title"><a href={href}>{title}</a></Heading>
	<p class="summary">{summary}</p>
	<Label>{stack.join(' · ')}</Label>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
	}
	.media {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		margin-bottom: var(--space-2);
		overflow: hidden;
		background: var(--color-surface);
	}
	.media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.placeholder {
		display: flex;
		align-items: flex-end;
		width: 100%;
		height: 100%;
		padding: var(--space-3);
	}
	.placeholder span {
		color: var(--color-muted);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 1.1px;
		text-transform: uppercase;
	}
	.title {
		font-size: 20px;
	}
	.title a:hover {
		color: var(--color-body);
	}
	.summary {
		font-size: 14px;
	}
</style>
