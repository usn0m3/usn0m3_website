---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['label', className]}><slot /></span>

<style>
	.label {
		display: inline-block;
		color: var(--color-muted);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 1.1px;
		line-height: 1.4;
		text-transform: uppercase;
	}
</style>
