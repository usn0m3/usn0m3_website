---
import type { Post } from '../lib/collections';
import { formatDate, isoDate } from '../lib/content';
import { url } from '../lib/url';
import Label from './Label.astro';

interface Props {
	post: Post;
	headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const { title, description, pubDate, tags, draft } = post.data;
---

<article class="post-item">
	<time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
	<div class="body">
		<Heading class="title"><a href={url(`/blog/${post.id}/`)}>{title}</a></Heading>
		<p class="description">{description}</p>
		{(tags.length > 0 || draft) && <Label>{[draft ? 'Draft' : '', ...tags].filter(Boolean).join(' · ')}</Label>}
	</div>
</article>

<style>
	.post-item {
		display: grid;
		grid-template-columns: 160px minmax(0, 1fr);
		gap: var(--space-3);
		padding-block: var(--space-4);
		border-top: 1px solid var(--color-hairline);
	}
	time {
		color: var(--color-muted);
		font-size: 13px;
	}
	.body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
	}
	.title {
		font-size: 20px;
	}
	.title a:hover {
		color: var(--color-body);
	}
	.description {
		font-size: 14px;
	}
	@media (max-width: 720px) {
		.post-item {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-2);
		}
	}
</style>
