---
import type { Profile } from '../lib/collections';
import Button from './Button.astro';
import Label from './Label.astro';

interface Props {
	profile: Profile;
}

const { profile } = Astro.props;
---

<section class="hero container">
	<Label>{profile.role} · {profile.location}</Label>
	<h1 class="headline">{profile.headline}</h1>
	<p class="intro">{profile.intro}</p>
	<div class="actions hero-actions">
		<Button href="/projects/">View projects</Button>
		{
			profile.links.linkedin && (
				<Button href={profile.links.linkedin} variant="outline">
					LinkedIn
				</Button>
			)
		}
	</div>
	<a class="contact" href={`mailto:${profile.email}`}>Get in touch →</a>
</section>

<style>
	.hero {
		padding-block: var(--space-9) var(--space-8);
	}
	.headline {
		max-width: 16ch;
		margin-top: var(--space-3);
		font-size: clamp(44px, 8vw, 80px);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}
	.intro {
		max-width: 52ch;
		margin-top: var(--space-4);
		font-size: 18px;
	}
	.hero-actions {
		margin-top: var(--space-6);
	}
	.contact {
		display: inline-block;
		margin-top: var(--space-4);
		padding-bottom: 2px;
		border-bottom: 1px solid var(--color-primary);
		color: var(--color-ink);
		font-size: 14px;
	}
	.contact:hover {
		color: var(--color-body);
	}
	@media (max-width: 720px) {
		.hero {
			padding-block: var(--space-7);
		}
	}
</style>
